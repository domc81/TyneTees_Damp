# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / Scheduled Tasks
# Required for authenticated cron endpoints (e.g. /api/cron/booking-reminders).
# Set a strong random secret in Coolify environment variables.
CRON_SECRET=your-cron-secret-here

# DC81 Central Usage Tracking (optional — emitter no-ops when absent)
# Ingest endpoint on vp-api (internal coolify network)
DC81_USAGE_INGEST_URL=http://vp-api:8000/usage/events
DC81_USAGE_INGEST_KEY=your-usage-ingest-key-here
DC81_USAGE_PROJECT=ttdp
